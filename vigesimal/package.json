{
  "name": "vigesimal",
  "version": "2.0.0-next.0",
  "description": "Compact structured data for LLM context, with verified round-trips and measured JSON fallback",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "vigesimal": "./bin/vigesimal.mjs"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync:playground": "npm run build && node scripts/sync-playground.mjs",
    "check:playground": "node scripts/sync-playground.mjs --check",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "quality:prepare": "npm run build && node scripts/quality-eval.mjs prepare",
    "quality:score": "node scripts/quality-eval.mjs score",
    "quality:test": "node --test scripts/quality-eval.test.mjs",
    "test:package": "npm run build && node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@toon-format/toon": "4.1.1",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "fast-check": "4.9.0",
    "js-tiktoken": "1.0.21",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmenchaca2/Vigesimal.git",
    "directory": "vigesimal"
  },
  "homepage": "https://github.com/hmenchaca2/Vigesimal#readme",
  "bugs": {
    "url": "https://github.com/hmenchaca2/Vigesimal/issues"
  },
  "author": "Homero Menchaca",
  "keywords": [
    "llm",
    "tokens",
    "serialization",
    "compression",
    "prompt-engineering",
    "context-window",
    "anthropic",
    "claude",
    "toon",
    "csv",
    "agent"
  ],
  "sideEffects": false
}
