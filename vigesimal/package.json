{
  "name": "vigesimal",
  "version": "1.0.0",
  "description": "Token-efficient serialization for LLM context \u2014 beats TOON and JSON on accuracy and tokens (benchmark-validated on two Claude models)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmenchaca2/Vigesimal.git",
    "directory": "vigesimal"
  },
  "homepage": "https://github.com/hmenchaca2/Vigesimal#readme",
  "bugs": {
    "url": "https://github.com/hmenchaca2/Vigesimal/issues"
  },
  "author": "Homero Menchaca",
  "keywords": [
    "llm",
    "tokens",
    "serialization",
    "compression",
    "prompt-engineering",
    "context-window",
    "anthropic",
    "claude",
    "toon",
    "csv",
    "agent"
  ],
  "sideEffects": false
}